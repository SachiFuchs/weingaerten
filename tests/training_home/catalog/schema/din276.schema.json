{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weingaerten/din276",
  "title": "DIN-276-Referenzliste (catalog/reference/din276.json)",
  "type": "object",
  "required": ["id", "name", "groups"],
  "additionalProperties": false,
  "properties": {
    "id":          { "const": "din276" },
    "name":        { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "additionalProperties": false,
        "properties": {
          "code":   { "type": "string", "pattern": "^[1-8][0-9]{2}$" },
          "name":   { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "pattern": "^[1-8][0-9]{2}$" },
          "trade":  { "type": "string", "description": "Gewerk; nur KG 4xx, wird an TGA-Komponenten abgeleitet statt gespeichert" }
        }
      }
    }
  }
}
