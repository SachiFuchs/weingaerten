{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weingaerten/material",
  "title": "Material",
  "type": "object",
  "$defs": {
    "detail_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": { "label": { "type": "string", "minLength": 1 }, "value": { "type": "string" } }
      }
    }
  },
  "required": ["id", "name", "category", "appearance"],
  "additionalProperties": false,
  "properties": {
    "id":           { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "photos": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(jpg|jpeg|png|webp)$" } },
    "name":         { "type": "string", "minLength": 1 },
    "category":     { "type": "string", "minLength": 1 },
    "description":  { "type": "string" },
    "conductivity": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Wärmeleitfähigkeit λ in W/(m·K); vorerst null" },
    "density":      { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Rohdichte ρ in kg/m³" },
    "vapour_resistance": { "type": ["number", "null"], "minimum": 0, "description": "Wasserdampf-Diffusionswiderstandszahl μ (dimensionslos)" },
    "fire_class":   { "enum": ["A1", "A2", "B1", "B2", "B3", null], "description": "Baustoffklasse nach DIN 4102-1 (A1/A2 nichtbrennbar, B1 schwer-, B2 normal-, B3 leicht entflammbar)" },
    "imported_from": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(ean|obi|hornbach)-[0-9]*_[a-z0-9_-]+$" },
      "description": "Herkunft aus dem Import-Eingang: Dateinamen (ohne .json) in catalog/imported_material"
    },
    "product": {
      "type": "object",
      "description": "Material als gekaufter Artikel eines Herstellers, bezogen über Lieferanten (wie component.product)",
      "additionalProperties": false,
      "properties": {
        "manufacturer": { "type": "string", "pattern": "^company:[a-z0-9]+(-[a-z0-9]+)*$" },
        "model":        { "type": "string" },
        "article_no":   { "type": "string" },
        "ean":          { "type": "string", "pattern": "^[0-9]+$" },
        "url":          { "type": "string" },
        "details": {
          "type": "object",
          "description": "Angaben der Shop-Produktseite je Abschnitt (product_data = Produktdaten, dimensions_weight = Maße & Gewicht); label/value im Originaltext",
          "additionalProperties": false,
          "properties": {
            "product_data":      { "$ref": "#/$defs/detail_rows" },
            "dimensions_weight": { "$ref": "#/$defs/detail_rows" }
          }
        },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["supplier", "price"],
            "additionalProperties": false,
            "properties": {
              "supplier":    { "type": "string", "pattern": "^company:[a-z0-9]+(-[a-z0-9]+)*$" },
              "price":       { "type": "number", "minimum": 0, "description": "Preis je Verkaufseinheit (Gebinde, Stück)" },
              "currency":    { "type": "string", "default": "EUR" },
              "price_basis": { "enum": ["net", "gross"], "description": "fehlt = nicht angegeben" },
              "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "source":      { "type": "string", "description": "Beleg, z. B. Kassenbon + Markt" },
              "document":    { "type": "string", "pattern": "^document:[a-z0-9]+(-[a-z0-9]+)*$", "description": "Beleg im Katalog" }
            }
          }
        }
      }
    },
    "values_source": { "type": "string", "description": "Herkunft der Kennwerte, z. B. \"Richtwert\", \"Datenblatt\"" },
    "appearance": {
      "type": "object",
      "required": ["color"],
      "additionalProperties": false,
      "properties": {
        "color":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "hatch":     { "enum": ["none", "plaster", "masonry", "concrete", "insulation", "wood"] }
      }
    }
  }
}
