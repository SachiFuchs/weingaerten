{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weingaerten/component",
  "title": "Bauteil (Fenster, Tür, …) – Instanz-Typ einer Klasse, aus Materialien, optional als Produkt",
  "type": "object",
  "required": ["id", "name", "class", "opening_capable", "params", "materials"],
  "additionalProperties": false,
  "properties": {
    "id":              { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "photos": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(jpg|jpeg|png|webp)$" } },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "class":           { "type": "string", "pattern": "^class:[a-z0-9]+(-[a-z0-9]+)*$" },
    "opening_capable": { "type": "boolean", "description": "für Öffnungen geeignet" },
    "ifc": {
      "type": "object",
      "description": "Optional: überschreibt die IFC-Zuordnung der Klasse (z. B. Balkontür in Klasse Fenster → IfcDoor). Vom Core nicht ausgewertet",
      "required": ["entity"],
      "additionalProperties": false,
      "properties": {
        "entity":          { "type": "string", "pattern": "^Ifc[A-Z][A-Za-z]+$", "description": "z. B. IfcDoor" },
        "predefined_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "PredefinedType; USERDEFINED zusammen mit object_type" },
        "object_type":     { "type": "string", "minLength": 1, "description": "ObjectType bei predefined_type USERDEFINED" }
      }
    },
    "params":          { "type": "object", "description": "Werte zu den Parametern der Klasse (Längen in m)" },
    "materials":       { "type": "object", "description": "Materialrolle der Klasse → material:<id>" },
    "imported_from":   { "type": "array", "items": { "type": "string" }, "description": "Quelldateien in catalog/imported_material (ohne .json)" },
    "product": {
      "type": "object",
      "description": "Bauteil als fertiges Produkt eines Herstellers, bezogen über Lieferanten",
      "additionalProperties": false,
      "properties": {
        "manufacturer": { "type": "string", "pattern": "^company:[a-z0-9]+(-[a-z0-9]+)*$" },
        "model":        { "type": "string" },
        "article_no":   { "type": "string" },
        "ean":          { "type": "string", "pattern": "^[0-9]+$" },
        "url":          { "type": "string" },
        "details":      { "type": "object", "description": "Angaben der Shop-Produktseite (wie material.product.details)" },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["supplier", "price"],
            "additionalProperties": false,
            "properties": {
              "supplier":    { "type": "string", "pattern": "^company:[a-z0-9]+(-[a-z0-9]+)*$" },
              "price":       { "type": "number", "minimum": 0, "description": "Preis je Stück" },
              "currency":    { "type": "string", "default": "EUR" },
              "price_basis": { "enum": ["net", "gross"], "description": "fehlt = nicht angegeben" },
              "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "source":      { "type": "string", "description": "Beleg, z. B. Rechnung/Bestellung + Position" },
              "document":    { "type": "string", "pattern": "^document:[a-z0-9]+(-[a-z0-9]+)*$", "description": "Beleg im Katalog" }
            }
          }
        }
      }
    }
  }
}
